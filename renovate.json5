{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    "github>DevSecNinja/.github//.renovate/autoMerge.json5",
    "github>DevSecNinja/.github//.renovate/base.json5",
    "github>DevSecNinja/.github//.renovate/customManagers.json5",
    "github>DevSecNinja/.github//.renovate/groups.json5",
    "github>DevSecNinja/.github//.renovate/labels.json5",
    "github>DevSecNinja/.github//.renovate/packageRules.json5",
    "github>DevSecNinja/.github//.renovate/semanticCommits.json5",
  ],
  // The org customManagers preset (above) tracks `#vX.Y.Z` tag pins. The
  // external primitives in apm.yml (github/awesome-copilot agents,
  // cloudflare/security-audit-skill) are pinned to a commit SHA on the upstream
  // default branch (no release tags), so they need their own manager: track
  // main's HEAD as a digest. Any `owner/repo/<subpath>#<40-hex SHA>` entry is
  // picked up; a new dependency on a non-`main` default branch needs its own
  // manager. A merged bump triggers apm-materialize.yml, which regenerates
  // .github/agents/ and .agents/skills/ for review.
  customManagers: [
    {
      customType: "regex",
      description: "Bump SHA-pinned external APM primitives in apm.yml",
      managerFilePatterns: ["/^apm\\.yml$/"],
      matchStrings: [
        "(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/[^#\\s]+#(?<currentDigest>[0-9a-f]{40})",
      ],
      packageNameTemplate: "https://github.com/{{{depName}}}",
      datasourceTemplate: "git-refs",
      currentValueTemplate: "main",
    },
  ],
  packageRules: [
    {
      // The shared autoMerge preset merges digest bumps unattended, but this
      // bump PR only shows a SHA. The agent text it pulls in surfaces in the
      // follow-up APM Materialize PR, so the owner reviews and merges both.
      // Renovate adds labels from every matching rule and can't remove one,
      // so the preset's `merge: auto` label stays; `automerge: false` wins.
      // The shared presets also disable digest updates and batch non-major
      // updates into one weekly PR: re-enable them here and keep this bump in
      // its own PR. git-refs has no release timestamps, so the 14-day soak
      // can't apply; without timestamp-optional the update stays pending.
      // Every dependency in apm.yml is third-party primitive text, so match
      // the file rather than a list of names that a new dependency could miss.
      description: "Never auto-merge external APM primitive bumps: third-party agent and skill text needs owner review",
      matchFileNames: ["apm.yml"],
      enabled: true,
      groupName: null,
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: false,
      commitMessageSuffix: "",
      addLabels: ["external-primitives", "merge: manual"],
    },
  ],
}
